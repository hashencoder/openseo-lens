{
  "manifest_version": 3,
  "name": "OpenSEO Lens",
  "short_name": "SEO Lens",
  "version": "1.2.3",
  "description": "Free, open-source SEO toolbar, no sign-in: on-page audit, keyword difficulty & demand, backlinks, links, schema, redirects, Core Web Vitals and SERP overlay.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OpenSEO Lens",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/vitals.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/linkgraph.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.in/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.ca/search*",
        "https://www.google.com.au/search*",
        "https://www.google.de/search*",
        "https://www.google.fr/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*"
      ],
      "js": [
        "content/serp.js"
      ],
      "css": [
        "content/serp.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    },
    "toggle-highlight": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Highlight nofollow / external links on the page"
    }
  }
}
